#include "splitkb_aurora_sofle.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan;
    };

    kscan: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;

        diode-direction = "col2row";

        row-gpios
            = <&pro_micro 20 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>
            , <&pro_micro 15 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>
            , <&pro_micro 18 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>
            , <&pro_micro 19 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>
            , <&pro_micro 14 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>
            ;

        col-gpios
            = <&pro_micro 9 GPIO_ACTIVE_HIGH>
            , <&pro_micro 8 GPIO_ACTIVE_HIGH>
            , <&pro_micro 7 GPIO_ACTIVE_HIGH>
            , <&pro_micro 6 GPIO_ACTIVE_HIGH>
            , <&pro_micro 5 GPIO_ACTIVE_HIGH>
            , <&pro_micro 4 GPIO_ACTIVE_HIGH>
            ;
    };
};

/*
 * ============================================================================
 * Cirque Pinnacle trackpad  (OPTIONAL - fully commented out until wired up)
 * ----------------------------------------------------------------------------
 * This template assumes the trackpad is mounted on the LEFT half. If yours is
 * on the RIGHT, move this whole block into splitkb_aurora_sofle_right.overlay.
 *
 * To turn it on you must uncomment THREE things together:
 *   1. this block
 *   2. the cirque-input-module entry in config/west.yml
 *   3. the CONFIG_ZMK_POINTING block in config/splitkb_aurora_sofle.conf
 *
 * Driver: https://github.com/petejohanson/cirque-input-module
 * Docs:   https://zmk.dev/docs/development/hardware-integration/pointing
 *
 * Choose ONE wiring below (I2C or SPI). Replace every placeholder pin - shown
 * as `pro_micro N` / `NRF_PSEL(... , X)` - with the actual GPIO you solder to.
 * The Aurora Sofle already runs the OLED on I2C, so Option A adds the fewest
 * wires (just the data-ready pad); the trackpad and OLED share the bus.
 * ============================================================================

// ---- Option A: I2C (recommended - reuses the existing OLED I2C bus) ----
&pro_micro_i2c {
    status = "okay";

    trackpad: trackpad@2a {
        compatible = "cirque,pinnacle";
        reg = <0x2a>;                                 // Cirque Pinnacle default I2C address
        dr-gpios = <&pro_micro N (GPIO_ACTIVE_HIGH)>;  // TODO: set the data-ready (DR) pad
        sensitivity = "2x";                           // 1x | 2x | 3x | 4x
        // rotate-90;
        // x-invert;
        // y-invert;
        // no-taps;                                   // disable tap-to-click (use if you add real buttons)
        // sleep;                                     // let the pad sleep to save battery
        status = "okay";
    };
};

// ---- Option B: SPI (use INSTEAD of Option A; needs SCK/MOSI/MISO/CS + DR) ----
