// ---- Input listener (required for either option) ----
/ {
    trackpad_listener: trackpad_listener {
        compatible = "zmk,input-listener";
        device = <&trackpad>;
        // Optional pointer scaling / drag-scroll processors are added here;
        // see the ZMK pointing docs linked above for the processor names.
    };
};
*/
