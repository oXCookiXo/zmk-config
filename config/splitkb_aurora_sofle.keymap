 *
 * splitkb.com Aurora Sofle - 7 layers, ported from the Elora Vial keymap.
 *
 * Thumb keys (outer to inner):
 *   left:  GUI  ALT  L6 (macros)  L4 (hold) / SPACE (tap)  L2 (hold) / ENTER (tap)
 *   right: L3 (hold) / ENTER (tap)  L5 (hold) / SPACE (tap)  SEL  RALT  RGUI
 *
 * Layers:
 *   L2 nav (ESDF arrows, home/end/page), L3 numpad + mirrored right-hand letters,
 *   L4 F-keys, L5 mirrored left-hand letters on the right hand, L6 macros/shortcuts.
 *   SEL (hold the right SEL thumb) holds BT profiles, RGB, F-keys, and &tog keys
 *   for L2-L6. Every non-base layer has &to BASE on its top-left key.
 *
 * Not ported: mouse buttons/accel and pointer overrides (no pointing device),
 * tap-dance shift/caps, encoder key overrides, extra bottom-row keys.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define SEL  1
#define L2   2
#define L3   3
#define L4   4
#define L5   5
#define L6   6

/* Underglow LED chain length (per-key LEDs only). */
&led_strip {
    // chain-length = <6>;
    // chain-length = <35>; // Uncomment if using both per-key and underglow LEDs
    chain-length = <29>; // Uncomment if using only per-key LEDs.
};

/ {
    behaviors {
        td0: td_digit_0 { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp N0>, <&kp LS(N0)>; };
        td1: td_digit_1 { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp N1>, <&kp LS(N1)>; };
        td2: td_digit_2 { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp N2>, <&kp LS(N2)>; };
        td3: td_digit_3 { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp N3>, <&kp LS(N3)>; };
        td4: td_digit_4 { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp N4>, <&kp LS(N4)>; };
        td5: td_digit_5 { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp N5>, <&kp LS(N5)>; };
        td6: td_digit_6 { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp N6>, <&kp LS(N6)>; };
        td7: td_digit_7 { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp N7>, <&kp LS(N7)>; };
        td8: td_digit_8 { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp N8>, <&kp LS(N8)>; };
        td9: td_digit_9 { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp N9>, <&kp LS(N9)>; };

        bspc_del: bspc_del {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        macro_select: macro_select {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings = <&macro_press &kp LSHFT>, <&macro_tap &kp S &kp E &kp L &kp E &kp C &kp T>, <&macro_release &kp LSHFT>, <&macro_tap &kp RET &kp LS(N8) &kp RET>, <&macro_press &kp LSHFT>, <&macro_tap &kp F &kp R &kp O &kp M>, <&macro_release &kp LSHFT>;
        };

        macro_delete: macro_delete {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings = <&macro_press &kp LSHFT>, <&macro_tap &kp D &kp E &kp L &kp E &kp T &kp E>, <&macro_release &kp LSHFT>, <&macro_tap &kp SPACE>;
        };

        macro_kcc: macro_kcc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            tap-ms = <50>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp K &kp C>, <&macro_release &kp LCTRL>;
        };

        macro_kcu: macro_kcu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            tap-ms = <50>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp K &kp U>, <&macro_release &kp LCTRL>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
// ------------------------------------------------------------------------------------------------------------
// | GESC  | 1*  | 2*  | 3*   | 4*   | 5*   |                   | 6*   | 7*    | 8*    | 9*   | 0*    | MUTE  |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BSPC  |
// |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
//               | GUI | ALT  | L6   | L4/SPC | L2/RET |  | L3/RET | L5/SPC | SEL | RALT | RGUI |
// * tap = digit, double tap = shifted symbol. Shift + BSPC = DEL.
            bindings = <
&gresc    &td1   &td2    &td3    &td4    &td5                           &td6   &td7   &td8      &td9    &td0     &kp C_MUTE
&kp TAB   &kp Q  &kp W   &kp E   &kp R   &kp T                          &kp Y  &kp U  &kp I     &kp O   &kp P    &bspc_del
&kp LCTRL &kp A  &kp S   &kp D   &kp F   &kp G                          &kp H  &kp J  &kp K     &kp L   &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X   &kp C   &kp V   &kp B  &kp LBKT    &kp RBKT    &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                 &kp LGUI &kp LALT &mo L6 &lt L4 SPACE &lt L2 RET  &lt L3 RET &lt L5 SPACE &mo SEL &kp RALT &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sel_layer {
            display-name = "SEL";
// Number row toggles a layer on/off. Home row = BT profiles. F-keys + RGB too.
            bindings = <
&to BASE   &tog SEL     &tog L2      &tog L3      &tog L4      &tog L5                          &tog L6 &trans   &trans   &trans   &trans   &trans
&trans     &kp F1       &kp F2       &kp F3       &kp F4       &kp F5                           &kp F6  &kp F7   &kp F8   &kp F9   &kp F10  &kp F11
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                     &trans  &trans   &trans   &trans   &trans   &kp F12
&trans     &rgb_ug RGB_TOG &rgb_ug RGB_EFF &rgb_ug RGB_BRI &rgb_ug RGB_BRD &trans &trans &trans  &trans  &trans   &trans   &trans   &trans   &trans
                        &trans       &trans       &trans       &trans     &trans &trans  &trans  &trans   &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        l2_layer {
            display-name = "L2";
// Nav: ESDF arrows, INS/DEL/HOME/END/PGUP/PGDN on the right hand, inverted-T arrows on the right thumbs.
            bindings = <
&to BASE         &trans &trans   &trans    &trans    &trans                 &trans &trans      &trans    &trans    &trans &trans
&trans           &trans &trans   &kp UP    &trans    &trans                 &trans &kp INS     &kp HOME  &kp PG_UP &trans &kp BSLH
&kp LC(LA(DEL))  &trans &kp LEFT &kp DOWN  &kp RIGHT &trans                 &trans &kp DEL     &kp END   &kp PG_DN &trans &trans
&trans           &trans &trans   &trans    &trans    &trans &kp F5   &kp UP &trans &trans      &trans    &trans    &trans &trans
                        &trans   &trans    &kp F11   &kp LG(LA(K)) &trans   &kp LEFT &kp DOWN &kp RIGHT &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        l3_layer {
            display-name = "L3";
// Left hand types the right-hand letters (6-9 on top); right hand is a numpad.
            bindings = <
&to BASE &kp N6 &kp N7 &kp N8    &kp N9  &trans                    &trans &kp KP_NUMLOCK &kp KP_SLASH &kp KP_MULTIPLY &kp MINUS   &trans
&trans   &kp Y  &kp U  &kp I     &kp O   &kp P                     &trans &kp KP_N7      &kp KP_N8    &kp KP_N9       &kp KP_PLUS &trans
&trans   &kp H  &kp J  &kp K     &kp L   &kp SEMI                  &trans &kp KP_N4      &kp KP_N5    &kp KP_N6       &kp KP_COMMA &trans
&trans   &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &trans    &trans  &trans &kp KP_N1      &kp KP_N2    &kp KP_N3       &kp KP_EQUAL &trans
                &trans &trans    &trans  &trans   &trans    &trans  &trans &trans         &kp KP_N0    &kp KP_DOT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        l4_layer {
            display-name = "L4";
// F1-F12 across the number row. Mouse buttons from the Elora are not ported.
            bindings = <
&to BASE &kp F2 &kp F3 &kp F4 &kp F5 &kp F6                 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
&trans   &trans &trans &trans &trans &trans                 &trans &trans &trans &trans  &trans  &trans
&trans   &trans &trans &trans &trans &trans                 &trans &trans &trans &trans  &trans  &trans
&trans   &trans &trans &trans &trans &trans &kp SQT  &trans &trans &trans &trans &trans  &trans  &trans
                &trans &trans &kp BSPC &trans &trans   &trans &trans &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        l5_layer {
            display-name = "L5";
// Left-hand letters mirrored onto the right hand.
            bindings = <
&to BASE &trans &trans &trans &trans &trans                 &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &trans
&trans   &trans &trans &trans &trans &trans                 &kp Q  &kp W  &kp E  &kp R  &kp T  &kp EQUAL
&trans   &trans &trans &trans &trans &trans                 &kp A  &kp S  &kp D  &kp F  &kp G  &trans
&trans   &trans &trans &trans &trans &trans &trans   &trans &kp Z  &kp X  &kp C  &kp V  &kp B  &trans
                &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        l6_layer {
            display-name = "L6";
// Macros and editor/IDE shortcuts (left hand).
            bindings = <
&to BASE       &kp LC(LA(N1)) &trans          &kp LC(F12)    &trans          &trans                 &trans &trans &trans &trans &trans &trans
&macro_delete  &trans         &trans          &kp LG(E)      &kp LC(LA(P))   &kp LC(LS(T))          &trans &trans &trans &trans &trans &trans
&macro_kcu     &trans         &kp RC(RA(S))   &kp LC(LS(P))  &kp LC(LS(F))   &trans                 &trans &trans &trans &trans &trans &trans
&macro_kcc     &trans         &kp LC(X)       &kp LC(C)      &kp LC(V)       &kp RC(RA(B)) &trans   &trans &trans &trans &trans &trans &trans &trans
                              &trans &kp LG(LA(K)) &trans &trans &trans   &trans &trans &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
